# Configuración de Base de Datos
BD_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/titta_db?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Configuración de JWT
JWT_KEY_SECRET=ChangeThisSecretKeyToSomethingVerySecureAndLongenough123456789
JWT_USER_GENERATOR=TittaApi
JWT_EXPIRATION_TIME=3600000
JWT_REFRESH_EXPIRATION_TIME=86400000

# Configuración de la Aplicación
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
APP_COOKIE_SECURE=false

# Configuración de Stripe
STRIPE_API_KEY=sk_test_placeholder
STRIPE_CURRENCY=usd

# Configuración de Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret
